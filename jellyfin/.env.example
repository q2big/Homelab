# Hostname for Jellyfin (local DNS only).
DOMAIN=jellyfin.example.com

# VM address that Traefik binds to, and the gateway used for DNS.
VM_IP=
GATEWAY_IP=

# Internal Docker network, and Traefik's fixed address in it (set as known proxy in Jellyfin).
DOCKER_SUBNET=
TRAEFIK_IP=

# Jellyfin runs as the same UID/GID as the "jellyfin" user on the NAS.
JELLYFIN_UID=
JELLYFIN_GID=

# Unprivileged UID for Traefik; must own traefik/acme.
TRAEFIK_UID=

# Email for Let's Encrypt expiry notices.
ACME_EMAIL=

# Cloudflare API token: Zone > DNS > Edit for this zone only.
CF_DNS_API_TOKEN=