FROM docker.io/library/debian:trixie-slim

ARG TOFU_VERSION
ARG TALOS_VERSION
ARG KUBECTL_VERSION
ARG SOPS_VERSION
ARG AGE_VERSION
ARG FLUX_VERSION

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip git openssh-client \
 && rm -rf /var/lib/apt/lists/*

# OpenTofu
RUN set -eux; cd /tmp; \
    curl -fsSLo tofu.zip "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_amd64.zip"; \
    unzip tofu.zip tofu -d /usr/local/bin; \
    rm -f tofu.zip

# talosctl
RUN set -eux; \
    curl -fsSLo /usr/local/bin/talosctl "https://github.com/siderolabs/talos/releases/download/v${TALOS_VERSION}/talosctl-linux-amd64"; \
    chmod +x /usr/local/bin/talosctl

# kubectl
RUN set -eux; \
    curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl"; \
    chmod +x /usr/local/bin/kubectl

# SOPS
RUN set -eux; \
    curl -fsSLo /usr/local/bin/sops "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.amd64"; \
    chmod +x /usr/local/bin/sops

# age
RUN set -eux; cd /tmp; \
    curl -fsSLo age.tar.gz "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-amd64.tar.gz"; \
    tar -xzf age.tar.gz -C /usr/local/bin --strip-components=1 age/age age/age-keygen; \
    rm -f age.tar.gz

# Flux CLI
RUN set -eux; cd /tmp; \
    curl -fsSLo flux.tar.gz "https://github.com/fluxcd/flux2/releases/download/v${FLUX_VERSION}/flux_${FLUX_VERSION}_linux_amd64.tar.gz"; \
    tar -xzf flux.tar.gz -C /usr/local/bin flux; \
    rm -f flux.tar.gz

ENV HOME=/tmp
WORKDIR /work
CMD ["bash"]
